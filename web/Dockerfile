# syntax=docker/dockerfile:1.7
#
# facility_mfe runtime image: a static Module Federation remote served by
# nginx. Kong never serves these bytes -- the fleet's localhost topology puts
# every frontend asset behind the Nginx web gateway on host :80, while Kong
# owns APIs on host :8000 (see warehouse-infra's ADR on the split edges).
#
# @warehouse/ui-kit is a sibling checkout (file:../../warehouse-ui-kit in
# package.json), not a registry package, so it must be supplied as a named
# BuildKit context. Build from this directory:
#
#   docker build --build-context uikit=../../warehouse-ui-kit \
#     -t warehouse/facility-layout-frontend:local .

# Builder base and install strategy, both deliberate:
#
# 1. node:22-bookworm-slim, not node:26-alpine. These package-lock.json files
#    were generated by npm 10 on macOS and carry NO linux entries for the
#    platform-specific optional dependencies Vite 8 pulls in (@rolldown/
#    binding-linux-*, lightningcss-linux-*, @oxlint/binding-linux-*). npm 11
#    (node:26) rejects that outright with EUSAGE "lock file out of sync", and
#    npm's long-standing optional-dependency bug (npm/cli#4828) means even a
#    successful `npm ci` leaves the native binding missing, so `vite build`
#    then dies with "Cannot find native binding". Debian/glibc also matches
#    the *-gnu bindings that are actually published.
#
# 2. The lockfile is deliberately NOT used to install. npm/cli#4828 means a
#    lockfile that lacks an optional dependency for the *current* platform
#    will not install it even under `npm install`, so the build still dies
#    with "Cannot find native binding" for @rolldown/binding-linux-*. The
#    error message's own prescribed remedy is to resolve without the lockfile,
#    which is what the rm + `npm install --no-save` below does. Direct
#    dependency versions are still pinned by package.json's ranges, and
#    --no-save plus the rm happening only inside this throwaway build layer
#    means the committed lockfile is never read for resolution nor mutated.
# --- ui-kit build stage (sibling dependency) ---
FROM node:22-bookworm-slim AS uikit-build
WORKDIR /uikit
COPY --from=uikit . .
# The uikit named context is a sibling CHECKOUT on the developer's machine and
# may carry its own node_modules. That tree holds only the host platform's
# bindings, and npm would treat the packages as already installed and never
# fetch the linux ones -- so strip it (and the lockfile, per npm/cli#4828)
# before resolving. warehouse-ui-kit is gaining its own .dockerignore, but
# this stays so the build does not depend on which revision is checked out.
RUN --mount=type=cache,target=/root/.npm \
    rm -rf node_modules package-lock.json && npm install --no-save && npm run build

# --- remote build stage ---
FROM node:22-bookworm-slim AS build
WORKDIR /workspace/warehouse-ui-kit
COPY --from=uikit-build /uikit/package.json ./package.json
COPY --from=uikit-build /uikit/dist ./dist

WORKDIR /workspace/facility-layout/web
COPY package.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm install --no-save
COPY . .
RUN rm -f package-lock.json
RUN npm run build

# --- runtime stage ---
FROM nginxinc/nginx-unprivileged:1.31-alpine
# apk upgrade picks up CVE fixes published to the alpine branch since the base
# image was last rebuilt, matching warehouse-console's runtime stage. Root is
# only needed for this one step.
USER root
RUN apk upgrade --no-cache
USER nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=nginx:nginx /workspace/facility-layout/web/dist /usr/share/nginx/html
EXPOSE 8080

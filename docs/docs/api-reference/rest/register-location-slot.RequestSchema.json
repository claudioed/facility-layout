{"title":"Body","body":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["locationCode","locationType"],"properties":{"locationCode":{"type":"string","pattern":"^[A-Z0-9]+(-[A-Z0-9]+){6}$","description":"The full seven-segment code. Its Site/Area/Zone/Aisle segments must resolve to existing, Active aggregates.\n","example":"WH1-STOR-AMB-A07-03-02-B"},"locationType":{"type":"string","minLength":1,"description":"An already-registered LocationType name.","example":"PalletRack"},"capacityOverride":{"allOf":[{"type":"object","description":"A slot's physical envelope. Both dimensions must be strictly positive.","required":["maxWeightKg","maxVolumeM3"],"properties":{"maxWeightKg":{"type":"number","format":"double","minimum":0,"exclusiveMinimum":true,"description":"Maximum weight in kilograms.","example":1200},"maxVolumeM3":{"type":"number","format":"double","minimum":0,"exclusiveMinimum":true,"description":"Maximum volume in cubic metres.","example":2.4}},"title":"Capacity"}],"description":"Optional. Omit to inherit the LocationType's default envelope.\n"}},"title":"RegisterLocationSlotRequest"},"example":{"locationCode":"WH1-STOR-AMB-A07-03-02-B","locationType":"PalletRack"}}}}}
// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
//
// The compiler options are inlined from @docusaurus/tsconfig rather than
// extended from it: that preset still sets "baseUrl", which TypeScript 7
// removed (TS5102), so `extends` fails tsc even with no baseUrl here. "paths"
// resolves relative to this file, so "@site/*" needs no baseUrl.
{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
